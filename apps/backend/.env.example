# Used when running the backend directly on the host (`bun run dev`)
# against services started via `docker compose up postgres minio`.
# Copy to `.env`.

PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/video_arena

WEB_ORIGIN=http://localhost:5173
BETTER_AUTH_URL=http://localhost:4000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Google OAuth (better-auth social login) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- OpenRouter (video generation) ---
OPENROUTER_API_KEY=

# --- MinIO ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=video-arena
