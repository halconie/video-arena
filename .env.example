# Used by docker-compose.yml to configure every service at once.
# Copy to `.env` and fill in the secrets before running `docker compose up`.

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=video_arena

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=video-arena
# URL the *browser* uses to load uploaded/generated files. Only change this
# if MinIO is reachable at something other than localhost for your browser.
MINIO_PUBLIC_URL=http://localhost:9000

# --- Frontend <-> backend origins ---
WEB_ORIGIN=http://localhost:5173
VITE_BACKEND_URL=http://localhost:4000

# --- better-auth ---
BETTER_AUTH_URL=http://localhost:4000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Google OAuth (better-auth social login) ---
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- OpenRouter (video generation) ---
# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
